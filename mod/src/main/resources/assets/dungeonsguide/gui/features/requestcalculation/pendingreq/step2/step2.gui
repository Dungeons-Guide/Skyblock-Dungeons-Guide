<RoundRect radius="5" backgroundColor="#FF333333">
    <padding left="5" top="5" bottom="5" right="5">
        <col crossAlign="START">
            <Text text="§e§lStep 2" color="#FFFFFFFF" size="12"/>
            <size height="3"/>
            <Text text="Actually pre-calculate routes using zip" size="6" color="#FFFFFFFF"/>
            <size height="3"/>

            <slot bind:child="receipt"/>

            <size height="20">
                <SelectiveContainer bind:visible="purchase">
                    <RoundButton text="Purchase Credits" on:click="purchase" slot="true"/>
                    <RoundButton text="Request Pathfind" on:click="request" slot="false"/>
                    <Text text="Loading..." size="8" color="#FFFFFFFF" slot="loading"/>
                </SelectiveContainer>
            </size>
            <size height="5"/>

            <Text bind:text="err" size="8" color="#FFFF0000"/>

            <flexible>
                <size/>
            </flexible>
            <size height="3"/>
            <row>
                <flexible>
                    <line thickness="1" color="#FFFFFFFF"/>
                </flexible>
                <padding left="3" right="3">
                    <Text text="OR" color="#FFFFFFFF" size="8"/>
                </padding>
                <flexible>
                    <line thickness="1" color="#FFFFFFFF"/>
                </flexible>
            </row>
            <size height="3"/>
            <Text text="Locally pre-calculate on your PC" size="8" color="#FF777777"/>
            <size height="3"/>
            <size height="15">
                <row>
                    <flexible>
                        <RoundButton text="Open guide"/>
                    </flexible>
                    <size width="5"/>
                    <flexible>
                        <RoundButton text="Open directory"/>
                    </flexible>
                </row>
            </size>
        </col>
    </padding>
</RoundRect>