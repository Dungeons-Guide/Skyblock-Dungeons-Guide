<padding left="5" right="5" top="5">
    <RoundRect radius="5" backgroundColor="#FF333333">
        <padding left="5" top="5" right="5" bottom="5">
            <col crossAlign="START">
                <row>
                    <flexible>
                        <Text text="Remote Calculation Service Progress" color="#FFFFFFFF" size="12"/>
                    </flexible>
                    <size height="20" width="100">
                        <RoundButton text="Reload" on:click="reload"/>
                    </size>
                </row>

                <size height="5"/>
                <line/>
                <size height="5"/>

                <Text text="Request Metadata" color="#FFFFFFFF" size="12"/>
                <size height="5"/>
                <row>
                    <Text text="        Request ID: " color="#FFAAAAAA"/>
                    <Text bind:text="requestId" color="#FFFFFFFF"/>
                </row>
                <row>
                    <Text text="               Name: " color="#FFAAAAAA"/>
                    <Text bind:text="requestName" color="#FFFFFFFF"/>
                </row>
                <row>
                    <Text text="             Link to: " color="#FFAAAAAA"/>
                    <Text bind:text="linkTo" color="#FFFFFFFF"/>
                </row>
                <size height="5"/>
                <flexible>
                    <SelectiveContainer bind:visible="loading">
                        <bgcolor backgroundColor="#FF000000" slot="true">
                            <align vAlign="CENTER" hAlign="CENTER">
                                <Text text="Loading..." color="#FFFFFFFF" size="8"/>
                            </align>
                        </bgcolor>
                        <slot bind:child="progress" slot="false"/>
                    </SelectiveContainer>
                </flexible>
                <size height="5"/>
                <Text text="Download and Apply Precalculations" color="#FFFFFFFF" size="12"/>
                <size height="3"/>
                <Text text="Download is only available for 7 days after pathfind completes" color="#FFCCCCCC" size="8"/>
                <size height="5"/>
                <SelectiveContainer bind:visible="complete">
                    <row slot="true">
                        <size width="200" height="20">
                            <RoundButton text="Download and Auto Apply Result" on:click="downloadAndAutoApply"/>
                        </size>
                        <size width="5"/>
                        <size width="150" height="20">
                            <RoundButton text="Download in browser" on:click="download"/>
                        </size>
                    </row>
                    <Text text="Wait for pathfind to complete...." size="8" color="#FFCCCCCC" slot="false"/>
                </SelectiveContainer>

                <size height="5"/>
                <Text bind:text="error" color="#FFCC0000" size="8"/>
            </col>
        </padding>
    </RoundRect>
</padding>