<RoundRect radius="5" backgroundColor="#FF333333">
    <padding left="5" top="5" bottom="5" right="5">
        <col crossAlign="START">
            <row>
                <Text text="Metadata" size="16" color="#FFFFFFFF" />
            </row>
            <size height="3"/>
            <line color="#FFFFFFFF" dir="HORIZONTAL" thickness="1"/>
            <size height="3"/>
            <row>
                <flexible>
                    <row>
                        <Text text="Room Name: " color="#FFFFFFFF"/>
                        <Text bind:text="roomName" color="#FFEEEE00"/>
                    </row>
                </flexible>
                <flexible flex="2">
                    <row>
                        <Text text="Internal ID: " color="#FFFFFFFF"/>
                        <Text bind:text="roomUID" color="#FF777777"/>
                    </row>
                </flexible>
            </row>
            <size height="5"/>
            <row>
                <flexible>
                    <row>
                        <Text text="Secret Count: " color="#FFFFFFFF"/>
                        <Text bind:text="secretCount" color="#FF777777"/>
                    </row>
                </flexible>
                <flexible>
                    <row>
                        <Text text="Room Shape: " color="#FFFFFFFF"/>
                        <Text bind:text="roomShape" color="#FF777777"/>
                    </row>
                </flexible>
                <flexible>
                    <row>
                        <Text text="Room Type: " color="#FFFFFFFF"/>
                        <Text bind:text="roomType" color="#FF777777"/>
                    </row>
                </flexible>
            </row>
            <size height="5"/>
            <row crossAlign="START">
                <Text text="List of Room States (" color="#FFFFFFFF"/>
                <Text bind:text="roomStateCount" color="#FF777777"/>
                <Text text="): " color="#FFFFFFFF"/>
                <flexible>
                    <Text bind:text="roomStates" color="#FF777777"/>
                </flexible>
            </row>
            <size height="5"/>
            <row>
                <Text text="Effective Pathfind Ability Settings: " color="#FFFFFFFF"/>
                <flexible>
                    <size height="28">
                        <ScrollablePanel direction="HORIZONTAL">
                            <size width="248" height="20">
                                <slot bind:_="algorithmSetting"/>
                            </size>
                        </ScrollablePanel>
                    </size>
                </flexible>
            </row>
            <row mainAlign="END">
                <SelectiveContainer bind:visible="editable">
                    <row slot="true">
                        <size height="15" width="150">
                            <RoundButton text="Edit Override Ability Settings" on:click="editOverrideAbilitySettings"/>
                        </size>
                        <size width="5"/>
                        <size height="15" width="100">
                            <RoundButton text="Remove Override" on:click="removeOverrideAbilitySettings"/>
                        </size>
                    </row>
                    <size width="0" height="0" slot="false"/>
                </SelectiveContainer>
            </row>
            <size height="3"/>
            <size height="15" width="70">
                <RoundButton text="View Room!"/>
            </size>
            <size height="3"/>
            <SelectiveContainer bind:visible="editable">
                <col slot="true" crossAlign="START">
                    <row>
                        <size height="15" width="130">
                            <RoundButton text="Unlink Unused Precalcs" on:click="unlinkUnused"/>
                        </size>
                        <size width="5"/>
                        <size height="15" width="140">
                            <RoundButton text="Unlink Unknown Precalcs" on:click="unlinkUnknown"/>
                        </size>
                        <size width="5"/>
                        <size height="15" width="110">
                            <RoundButton text="Unlink All Precalcs" on:click="unlinkAll"/>
                        </size>
                    </row>
                    <size height="3"/>
                    <size height="15" width="180">
                        <RoundButton text="AutoLink Exact Match Precalcs" on:click="autolink"/>
                    </size>
                </col>
                <size width="0" height="0" slot="false"/>
            </SelectiveContainer>
        </col>
    </padding>
</RoundRect>