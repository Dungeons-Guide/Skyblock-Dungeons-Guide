<col>
    <RoundRect radius="5" backgroundColor="#FF555555">
        <IntrinsicHeight>
            <row crossAlign="STRETCH">
                <ConstrainedBox maxWidth="100" minWidth="100" maxHeight="+Infinity" minHeight="100">
                    <RoundRect radius="5" backgroundColor="#FF111111">
                        <padding left="10" top="10" right="10" bottom="10">
                            <align vAlign="CENTER" hAlign="CENTER">
                                <col>
                                    <ConstrainedBox maxWidth="70" maxHeight="70">
                                        <ResourceImage bind:location="image" width="128" height="128" textureWidth="128" textureHeight="128"/>
                                    </ConstrainedBox>
                                    <size height="5"/>
                                    <Text bind:text="mechanicName" color="#FFFFFFFF"/>
                                </col>
                            </align>
                        </padding>/
                    </RoundRect>
                </ConstrainedBox>
                <flexible>
                    <padding left="5" top="5" right="5" bottom="5">
                        <col bind:_="requests" bind:api="api"  crossAlign="START">

                        </col>
                    </padding>
                </flexible>
            </row>
        </IntrinsicHeight>
    </RoundRect>
    <size height="5"/>
</col>