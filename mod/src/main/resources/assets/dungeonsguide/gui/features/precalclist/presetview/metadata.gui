<RoundRect radius="5" backgroundColor="#FF333333">
    <padding left="5" top="5" bottom="5" right="5">
        <col>
            <row>
                <Text text="Metadata" size="16" color="#FFFFFFFF" />
            </row>
            <size height="3"/>
            <line color="#FFFFFFFF" dir="HORIZONTAL" thickness="1"/>
            <size height="3"/>
            <row>
                <flexible>
                    <row>
                        <Text text="Currently viewing: " color="#FFFFFFFF"/>
                        <flexible>
                            <Text bind:text="presetName" color="#FFFFFFFF"/>
                        </flexible>
                    </row>
                </flexible>
                <size height="15" width="75">
                    <RoundButton text="Change Name" on:click="changeName"/>
                </size>
                <size width="5"/>
                <size height="15" width="40">
                    <RoundButton text="Clone" on:click="clone"/>
                </size>
                <size width="5"/>
                <size height="15" width="40">
                    <RoundButton text="Delete" on:click="delete"/>
                </size>
            </row>
            <size height="5"/>
            <row mainAlign="END">
                <size height="16" width="50">
                    <RoundButton text="Export" on:click="export"/>
                </size>
            </row>
            <size height="5"/>
            <row>
                <Text text="Internal ID: " color="#FF777777"/>
                <Text bind:text="id" color="#FF777777"/>
            </row>
            <size height="5"/>
            <row>
                <Text text="Filename: " color="#FF777777"/>
                <Text bind:text="filename" color="#FF777777"/>
            </row>
            <size height="5"/>
            <row>
                <Text text="Generated At: " color="#FF777777"/>
                <Text bind:text="generatedAt" color="#FF777777"/>
            </row>
            <size height="5"/>
            <row>
                <Text text="Origin: " color="#FF777777"/>
                <Text bind:text="origin" color="#FF777777"/>
            </row>
            <size height="5"/>
            <row>
                <Text text="Editable: " color="#FFFFFFFF"/>
                <SelectiveContainer bind:visible="editable">
                    <Text text="Yes" color="#FF00FF00" slot="true"/>
                    <row slot="false">
                        <Text text="No" color="#FFFF0000"/>
                        <Text text=" (create clone and edit that one)" color="#FF777777"/>
                    </row>
                </SelectiveContainer>
            </row>
            <size height="5"/>
            <row>
                <Text text="Default Pathfind Ability Settings: " color="#FFFFFFFF"/>
                <size width="3"/>
                <flexible>
                    <size height="28">
                        <ScrollablePanel direction="HORIZONTAL">
                            <size width="248" height="20">
                                <slot bind:_="abilitySettings"/>
                            </size>
                        </ScrollablePanel>
                    </size>
                </flexible>
                <size width="5"/>
                <SelectiveContainer bind:visible="editable">
                    <size height="15" width="150" slot="true">
                        <RoundButton text="Edit Default Ability Settings" on:click="editAbilitySettings"/>
                    </size>
                    <size width="0" height="0" slot="false"/>
                </SelectiveContainer>
            </row>
            <size height="5"/>

            <SelectiveContainer bind:visible="editable">
                <row slot="true">
                        <size height="15" width="130">
                            <RoundButton text="Unlink Unused Precalcs" on:click="unlinkUnused"/>
                        </size>
                        <size width="5"/>
                        <size height="15" width="180">
                            <RoundButton text="AutoLink Exact Match Precalcs" on:click="autolink"/>
                        </size>
                </row>
                <size width="0" height="0" slot="false"/>
            </SelectiveContainer>

            <size height="5"/>
            <row>
                <size height="15" width="100">
                    <RoundButton text="Apply this preset" on:click="apply"/>
                </size>
                <size width="5"/>
                <size height="15" width="170">
                    <RoundButton text="Request Missing Precalculations" on:click="requestMissing"/>
                </size>
            </row>


        </col>
    </padding>
</RoundRect>