<padding left="5" right="5" top="5">
    <RoundRect radius="5" backgroundColor="#FF333333">
        <padding left="5" top="5" right="5" bottom="5">
            <col crossAlign="START">
                <row>
                    <flexible>
                        <Text text="Pathfind Credits" color="#FFFFFFFF" size="12"/>
                    </flexible>
                </row>
                <size height="5"/>
                <line color="#FFFFFFFF"/>
                <size height="5"/>
                <padding left="5" right="5">
                    <col crossAlign="START">
                        <row>
                            <Text text="Your total pathfind credits: " color="#FFFFFFFF" size="8"/>
                            <flexible><Text bind:text="credits" color="#FFFFFFFF" size="8"/></flexible>
                            <size width="5"/>
                            <size height="20" width="100">
                                <RoundButton text="Purchase Credits" on:click="purchaseCredits"/>
                            </size><size width="5"/>
                            <size height="20" width="100">
                                <RoundButton text="Reload" on:click="reload"/>
                            </size>
                        </row>

