<!--                            </row>-->
<!--                        </IntrinsicHeight>-->

                        <size height="3"/>

                        <Text text="1 credit allows you to request 1 unit-room pathfind with zip file" color="#FFCCCCCC" size="8"/>

                    </col>
                </padding>
                <size height="5"/>
                <Text bind:text="error" color="#FFCC0000" size="8"/>
            </col>
        </padding>
    </RoundRect>
</padding>