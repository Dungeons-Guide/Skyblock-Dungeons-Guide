    <col crossAlign="START">
        <row>
            <Text text="         Started at: " color="#FFAAAAAA"/>
            <Text bind:text="timestamp" color="#FFFFFFFF"/>
        </row>
        <row>
            <Text text="          States ID: " color="#FFAAAAAA"/>
            <Text bind:text="id" color="#FFFFFFFF"/>
        </row>
        <row>
            <Text text="  Current Status: " color="#FFAAAAAA"/>
            <Text bind:text="status" color="#FF00FFFF"/>
        </row>
        <row>
            <Text text="  Request Status: " color="#FFAAAAAA"/>
            <Text bind:text="requestStatus" color="#FFFFFFFF"/>
        </row>
        <row>
            <Text text="     Used Credits: " color="#FFAAAAAA"/>
            <Text bind:text="credits" color="#FFFFFFFF"/>
        </row>
        <row>
            <Text text="         Completed: " color="#FFAAAAAA"/>
            <Text bind:text="completed" color="#FFFFFFFF"/>
        </row>ec
        <size height="10"/>
        <Text text="Events" color="#FFFFFFFF" size="12"/>
        <size height="5"/>
        <flexible>
            <ScrollablePanel direction="VERTICAL">
                <col bind:_="events"></col>
            </ScrollablePanel>
        </flexible>
    </col>