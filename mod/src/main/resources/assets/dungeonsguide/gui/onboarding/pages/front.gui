<Include include="dungeonsguide:gui/onboarding/onboarding_layout.gui" title="Dungeons Guide Quick Setup Wizard">
    <slot>
        <ScrollablePanel direction="VERTICAL">
            <padding top="20" left="20" bottom="20" right="20">
                <col>
                    <size width="0" height="0">
                        <OnboardingCard id="$default" toggleGroup="" bind:controller="controller">
                            <slot slot="setting">
                                <feature id="secret.bloodrush"><_enabled>false</_enabled></feature>
                                <feature id="secret.mechanicbrowse"><_enabled>false</_enabled></feature>
                            </slot>
                        </OnboardingCard>
                    </size>

                    <Text text="Welcome To Dungeons Guide!!" size="12" color="#FFFFFFFF"/>
                    <size height="20"/>
                    <Text text="Thank you for installing §eDungeonsGuide§f, the most intelligent skyblock dungeon mod!" size="8" color="#FFFFFFFF"/>
                    <size height="10"/>
                    <Text text="This wizard will help you configure your mod settings for the best experience." color="#FFFFFFFF" size="8"/>
                    <size height="10"/>
                    <Text text="§lDon't worry! §rYou can always §echange these settings later §rin the mod configuration menu." color="#FFFFFFFF" size="8"/>
                    <size height="2"/>
                    <Text text="You can access Dungeons Guide Menu by typing §e/dg" color="#FFFFFFFF" size="8"/>
                    <size height="8"/>
                    <Text text="You can trigger this wizard again at §e/dg -> Setup Wizard" color="#FFCCCCCC" size="8"/>

                    <Variable bind:target="prevPage" value=""/>
                    <Variable bind:target="nextPage" value="pages/pathfinding.gui"/>
                    <Variable bind:target="requiredGroup" value=""/>
                </col>
            </padding>
        </ScrollablePanel>
    </slot>

    <slot slot="buttons">
        <Include include="dungeonsguide:gui/onboarding/standard_onboarding_buttons.gui" on:prev="prev" on:next="next" bind:disableNext="nextButtonDisabled" disablePrev="true"/>
    </slot>
</Include>